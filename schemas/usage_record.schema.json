{
  "$id": "https://openclaw.invalid/schemas/usage_record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt": {
      "minimum": 1,
      "type": "integer"
    },
    "cost_usd": {
      "minimum": 0,
      "type": "number"
    },
    "elapsed_seconds": {
      "minimum": 0,
      "type": "number"
    },
    "input_tokens": {
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "kind": {
      "enum": [
        "implementation",
        "repair",
        "review",
        "probe"
      ],
      "type": "string"
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "output_tokens": {
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "provider": {
      "type": [
        "string",
        "null"
      ]
    },
    "recorded_at": {
      "format": "date-time",
      "type": "string"
    },
    "runner": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "type": "string"
    },
    "tier": {
      "enum": [
        0,
        1,
        2
      ],
      "type": "integer"
    },
    "unit_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "unit_id",
    "runner",
    "tier",
    "attempt",
    "cost_usd",
    "elapsed_seconds"
  ],
  "title": "Budget and usage record",
  "type": "object"
}
