{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclaw.invalid/schemas/usage_record.schema.json",
  "title": "Budget and usage record",
  "type": "object",
  "required": [
    "schema_version",
    "unit_id",
    "runner",
    "tier",
    "attempt",
    "cost_usd",
    "elapsed_seconds"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "unit_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "runner": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": [
        "string",
        "null"
      ]
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "tier": {
      "type": "integer",
      "enum": [
        0,
        1,
        2
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "implementation",
        "repair",
        "review",
        "probe"
      ]
    },
    "input_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "output_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "cost_usd": {
      "type": "number",
      "minimum": 0
    },
    "elapsed_seconds": {
      "type": "number",
      "minimum": 0
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
