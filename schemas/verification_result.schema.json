{
  "$id": "https://openclaw.invalid/schemas/verification_result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "passed true requires every check passed; each check's passed must equal exit_code == 0.",
  "properties": {
    "checks": {
      "items": {
        "properties": {
          "command": {
            "type": "string"
          },
          "duration_seconds": {
            "minimum": 0,
            "type": "number"
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "command",
          "exit_code",
          "passed"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "output_excerpt": {
      "type": "string"
    },
    "passed": {
      "type": "boolean"
    },
    "schema_version": {
      "const": "1.0",
      "type": "string"
    },
    "unit_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "type": "string"
    },
    "verified_at": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "unit_id",
    "passed",
    "checks",
    "verified_at"
  ],
  "title": "Verification result",
  "type": "object"
}
