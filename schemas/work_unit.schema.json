{
  "$id": "https://openclaw.invalid/schemas/work_unit.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acceptance": {
      "additionalProperties": false,
      "properties": {
        "commands": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "paths": {
          "items": {
            "description": "Repository-relative path or glob that must match the pinned target tree.",
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "commands"
      ],
      "type": "object"
    },
    "budget": {
      "additionalProperties": false,
      "properties": {
        "attempts": {
          "minimum": 1,
          "type": "integer"
        },
        "maximum_cost_usd": {
          "minimum": 0,
          "type": "number"
        },
        "minutes": {
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "attempts",
        "minutes",
        "maximum_cost_usd"
      ],
      "type": "object"
    },
    "capabilities": {
      "additionalProperties": false,
      "properties": {
        "network": {
          "type": "boolean"
        },
        "secrets": {
          "description": "Environment variable NAMES only.",
          "items": {
            "pattern": "^[A-Z][A-Z0-9_]{0,127}$",
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "network",
        "secrets"
      ],
      "type": "object"
    },
    "depends_on": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
        "type": "string"
      },
      "type": "array"
    },
    "description": {
      "type": "string"
    },
    "health": {
      "additionalProperties": false,
      "description": "Per unit override of the repository policy health block. Hang detection. A running process is checked every interval_seconds; it is cancelled as hung only after flat_checks_for_hang consecutive checks in which CPU time, output, stream events, the worktree and the process set all stayed still. There is no wall clock limit.",
      "properties": {
        "flat_checks_for_hang": {
          "default": 5,
          "maximum": 20,
          "minimum": 2,
          "type": "integer"
        },
        "interval_seconds": {
          "default": 120,
          "maximum": 1800,
          "minimum": 30,
          "type": "number"
        }
      },
      "type": "object"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "type": "string"
    },
    "lint_exemptions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "minLength": 1,
            "type": "string"
          },
          "reason": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "code",
          "reason"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "provides": {
      "description": "Capability tokens used for transitive plan ordering checks.",
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "requires": {
      "description": "Capability tokens used for transitive plan ordering checks.",
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "type": "string"
    },
    "rollback": {
      "minLength": 1,
      "type": "string"
    },
    "routing": {
      "additionalProperties": false,
      "description": "initial_tier must not exceed maximum_tier (enforced by the Python validator).",
      "properties": {
        "initial_tier": {
          "enum": [
            0,
            1,
            2
          ],
          "type": "integer"
        },
        "maximum_tier": {
          "enum": [
            0,
            1,
            2
          ],
          "type": "integer"
        },
        "reviewer_must_differ_from_author": {
          "type": "boolean"
        }
      },
      "required": [
        "initial_tier",
        "maximum_tier",
        "reviewer_must_differ_from_author"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "1.0",
      "type": "string"
    },
    "scope": {
      "additionalProperties": false,
      "properties": {
        "files": {
          "items": {
            "description": "Repository relative POSIX path or glob; no '..' segments, no absolute or home paths.",
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "files"
      ],
      "type": "object"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "traits": {
      "items": {
        "enum": [
          "mechanical",
          "fixture_generation",
          "database",
          "security",
          "concurrency",
          "architecture",
          "previous_attempt_failed"
        ],
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "id",
    "title",
    "depends_on",
    "scope",
    "acceptance",
    "risk",
    "capabilities",
    "routing",
    "budget",
    "rollback"
  ],
  "title": "Work unit",
  "type": "object"
}
