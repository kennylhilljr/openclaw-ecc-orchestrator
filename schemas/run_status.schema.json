{
  "$id": "https://openclaw.invalid/schemas/run_status.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt": {
      "minimum": 0,
      "type": "integer"
    },
    "reason": {
      "type": "string"
    },
    "runner": {
      "type": [
        "string",
        "null"
      ]
    },
    "schema_version": {
      "const": "1.0",
      "type": "string"
    },
    "state": {
      "enum": [
        "pending",
        "running",
        "verifying",
        "succeeded",
        "failed",
        "escalated",
        "blocked",
        "cancelled"
      ],
      "type": "string"
    },
    "tier": {
      "enum": [
        0,
        1,
        2
      ],
      "type": "integer"
    },
    "unit_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "unit_id",
    "state",
    "tier",
    "attempt",
    "updated_at"
  ],
  "title": "Run status",
  "type": "object"
}
