{
  "$id": "https://openclaw.invalid/schemas/routing_decision.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "chosen_tier": {
      "enum": [
        0,
        1,
        2
      ],
      "type": "integer"
    },
    "decided_at": {
      "format": "date-time",
      "type": "string"
    },
    "estimated_cost_usd": {
      "minimum": 0,
      "type": [
        "number",
        "null"
      ]
    },
    "maximum_tier": {
      "enum": [
        0,
        1,
        2
      ],
      "type": "integer"
    },
    "minimum_tier": {
      "enum": [
        0,
        1,
        2
      ],
      "type": "integer"
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "provider": {
      "type": [
        "string",
        "null"
      ]
    },
    "reasons": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "review_tier": {
      "enum": [
        0,
        1,
        2
      ],
      "type": "integer"
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "type": "string"
    },
    "runner": {
      "type": [
        "string",
        "null"
      ]
    },
    "schema_version": {
      "const": "1.0",
      "type": "string"
    },
    "score": {
      "type": "integer"
    },
    "signals": {
      "items": {
        "properties": {
          "name": {
            "type": "string"
          },
          "points": {
            "type": "integer"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "points",
          "reason"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "unit_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "unit_id",
    "score",
    "signals",
    "risk",
    "minimum_tier",
    "chosen_tier",
    "maximum_tier",
    "reasons",
    "decided_at"
  ],
  "title": "Routing decision",
  "type": "object"
}
