{
  "$id": "https://openclaw.invalid/schemas/runner_certification.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "status certified requires every check present and none failing.",
  "properties": {
    "certified_at": {
      "format": "date-time",
      "type": "string"
    },
    "checks": {
      "items": {
        "properties": {
          "detail": {
            "type": "string"
          },
          "duration_seconds": {
            "minimum": 0,
            "type": "number"
          },
          "name": {
            "enum": [
              "installed",
              "authentication",
              "live_inference",
              "repo_exercise",
              "cancellation_timeout",
              "log_inspection",
              "metadata_capture"
            ],
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "skip"
            ],
            "type": "string"
          }
        },
        "required": [
          "name",
          "status",
          "reason"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "expires_at": {
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "family": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "coding_cli",
        "api"
      ],
      "type": "string"
    },
    "models": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "provider": {
      "minLength": 1,
      "type": "string"
    },
    "runner": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "type": "string"
    },
    "status": {
      "enum": [
        "certified",
        "failed",
        "not_configured",
        "retired"
      ],
      "type": "string"
    },
    "usage": {
      "type": [
        "object",
        "null"
      ]
    },
    "version": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "runner",
    "provider",
    "status",
    "checks",
    "certified_at",
    "version",
    "models"
  ],
  "title": "Runner certification record",
  "type": "object"
}
