#!/bin/zsh
# Run one command with provider API keys loaded from the macOS login Keychain.
#
# Usage: bin/with-keychain-secrets <command> [args...]
#
# Keys are stored once by the operator, for example:
#   security add-generic-password -a "$USER" -s GEMINI_API_KEY -w
# Only the names below are read. A key that is not in the Keychain is skipped,
# so the matching runner reports "not_configured". Keys are exported only into
# the environment of the command that follows (exec), never printed, logged, or
# written to disk. The orchestrator then passes each key only to its own
# provider's worker.
set -eu

if [[ $# -eq 0 ]]; then
  print -u2 "usage: bin/with-keychain-secrets <command> [args...]"
  exit 2
fi

for name in GEMINI_API_KEY GROQ_API_KEY MOONSHOT_API_KEY OPENROUTER_API_KEY; do
  if value="$(security find-generic-password -a "$USER" -s "$name" -w 2>/dev/null)"; then
    export "$name=$value"
    print -u2 "keychain: loaded $name"
  else
    print -u2 "keychain: $name not found (skipped)"
  fi
done
unset value

exec "$@"
