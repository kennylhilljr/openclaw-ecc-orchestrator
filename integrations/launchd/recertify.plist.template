<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.openclaw-ecc-orchestrator.recertify</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>__REPO__/bin/recertify-weekly</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>USER</key>
    <string>__USER__</string>
  </dict>
  <!-- Sundays at 09:00 local time; certifications last 7 days. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>0</integer>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/openclaw-ecc-orchestrator/recertify.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/openclaw-ecc-orchestrator/recertify.log</string>
</dict>
</plist>
